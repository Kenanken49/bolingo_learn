{
  "version": 1,
  "policy": "Every merge to main must clear every required gate. A failed required gate blocks CI, and the failure is published to the owner dashboard.",
  "gates": [
    {
      "id": "typecheck",
      "label": "TypeScript",
      "category": "static",
      "command": "npx tsc --noEmit",
      "timeoutSeconds": 300,
      "required": true
    },
    {
      "id": "lint",
      "label": "ESLint",
      "category": "static",
      "command": "npx expo lint",

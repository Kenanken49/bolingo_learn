# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AdMob (optional — Google test ids are the default)
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_REWARDED_IOS=ca-app-pub-3940256099942544/5224354917

# RevenueCat (required for real purchases; omit for debug mode)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Device-test backdoor (development builds only)
EXPO_PUBLIC_DEBUG_PREMIUM=1

# Set to exactly 1 to switch off anonymous telemetry at build time
# (lib/telemetry.ts). Use it in CI and in builds you do not want reporting
# from; any other value leaves the in-app Settings toggle in charge.
EXPO_PUBLIC_TELEMETRY_DISABLED=

# Website server (SERVER ONLY — Coolify runtime variables, see docs/web-publish.md).
# The Expo web export is built into the image, so every EXPO_PUBLIC_* value it
# needs must be set as a *build* variable in Coolify, not only at runtime.
#   DATABASE_URL=postgres://user:pass@host:5432/bolingo
#   DATABASE_SSL=require            # only if that Postgres needs TLS
#   DATABASE_POOL_MAX=5
#   MIGRATE_ON_START=1              # apply db/migrations on boot (one replica)

# Audiobook voice (SERVER ONLY — Supabase Edge Function secrets / local previews).
# Never prefix these with EXPO_PUBLIC_; see docs/audiobook-voice.md.
# TTS_PROVIDER=elevenlabs
# TTS_MODEL_ID=eleven_turbo_v2_5
# TTS_VOICE_ID=yj30vwTGJxSHezdAGsv9
# TTS_VOICE=alloy
# TTS_OUTPUT_FORMAT=mp3_44100_128
# TTS_STABILITY=0.5
# TTS_SIMILARITY_BOOST=0.75
# TTS_STYLE=0
# TTS_SPEAKER_BOOST=true
# TTS_API_KEY=
# Cloned/professional voices also require a completed, active consent record
# for the local preflight. Keep it outside this repository:
# TTS_CONSENT_RECORD=

# Audio/video transcription (SERVER ONLY — Supabase Edge Function secrets).
# Premium uploads only, after the in-app content-rights checklist.
# Deepgram is recommended for long audio and video: the function sends it a
# one-hour signed URL, so the file is never downloaded into the Edge Function.
# See docs/transcription.md.
# DEEPGRAM_API_KEY=
# TRANSCRIBE_PROVIDER=deepgram
# TRANSCRIBE_MODEL=nova-3
#
# Short clips can use an OpenAI-compatible /audio/transcriptions endpoint
# (25 MB max). Also works with Groq via TRANSCRIBE_BASE_URL.
# TRANSCRIBE_PROVIDER=openai
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_LANGUAGE=
# TRANSCRIBE_MAX_BYTES=
# TRANSCRIBE_TIMEOUT_MS=240000

# Natural Swahili lesson clips (SERVER/OPERATOR ONLY — never EXPO_PUBLIC_*).
# Generate with `node scripts/generate-fliki-swahili.cjs --confirm-rights`;
# see docs/fliki-swahili.md. The app plays bundled clips and never sees this key.
# FLIKI_API_KEY=
# FLIKI_VOICE_ID=
# FLIKI_VOICE_STYLE_ID=
# FLIKI_VOICE_NAME=

# M-Pesa premium rail (SERVER ONLY — Supabase Edge Function secrets; the app
# bundle never sees any of these). Install supabase/migrations_mpesa_premium.sql,
# then `supabase secrets set`. Get the pairs from the Daraja dashboard — keep
# sandbox keys until a live test payment succeeds. MPESA_CALLBACK_TOKEN is a
# secret you invent (long random string) and also embed in MPESA_CALLBACK_URL
# as ?t=<token>, because Safaricom cannot send a learner JWT. The consumer key
# and secret are credentials: never paste them into chat, a commit or a doc.
#   DARAJA_CONSUMER_KEY=
#   DARAJA_CONSUMER_SECRET=
#   DARAJA_SHORTCODE=
#   DARAJA_PASSKEY=
#   MPESA_CALLBACK_URL=https://<project>.supabase.co/functions/v1/mpesa-callback?t=<token>
#   MPESA_CALLBACK_TOKEN=
#   MPESA_ENV=sandbox
#   MPESA_PREMIUM_KES=770
#   MPESA_PENDING_TTL_MINUTES=5
#
# MPESA_ENV is the sandbox/live switch: `sandbox` (the default when unset) talks
# to https://sandbox.safaricom.co.ke, `production` to https://api.safaricom.co.ke
# - those two hosts are the only ones the code will use, so DARAJA_BASE_URL can
# never redirect a Daraja credential somewhere else. DARAJA_BASE_URL is still
# honoured (it selects the environment when MPESA_ENV is unset), but if the two
# disagree the Edge Function refuses to send a push rather than guess.
# MPESA_TRANSACTION_TYPE matches the product Safaricom issued you:
# CustomerPayBillOnline for a paybill (the default) or CustomerBuyGoodsOnline for
# a till. MPESA_ACCOUNT_REFERENCE (12 characters max) is the text on the prompt.
#   DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
#   MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
#   MPESA_ACCOUNT_REFERENCE=BolingoLearn
#
# Never keep live keys in this file. Put them in a file outside the repository
# and audit the whole configuration before anything is sent to Safaricom:
#   npm run mpesa:golive -- --from ~/mpesa-live.env

# Quality operations (SERVER/OPERATOR ONLY — never EXPO_PUBLIC_*).
# Install supabase/migrations_quality_ops.sql, then set these as Supabase
# Edge Function secrets. Email is provider-neutral; configure one path:
#   NOTIFY_EMAIL_WEBHOOK_URL=https://your-relay.example/hook
#   NOTIFY_EMAIL_WEBHOOK_TOKEN=
#   RESEND_API_KEY=
#   NOTIFY_EMAIL_FROM="Bolingo Learn <alerts@your-domain>"
#   NOTIFY_EMAIL_TO=bolingolearn@pm.me
#   ENGINEER_CRON_SECRET=
# CI publishing (GitHub repository secrets, not the app bundle):
#   QUALITY_SUPABASE_URL=
#   QUALITY_SUPABASE_SERVICE_ROLE_KEY=

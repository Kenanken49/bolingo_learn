# Bolingo backend configuration.
# Copy to .env and run `uvicorn app.main:app --reload --env-file .env`.
# Every setting has a working default, so the app also runs with no file.

# ---------------------------------------------------------------- persistence
# SQLite by default. Use a Postgres URL in production.
BOLINGO_DATABASE_URL=sqlite:///./bolingo.db
BOLINGO_UPLOAD_DIR=./var/uploads

# ------------------------------------------------------------------ ingestion
BOLINGO_MAX_UPLOAD_BYTES=10485760
BOLINGO_CHUNK_TARGET_CHARS=1200
BOLINGO_MAX_LESSONS_PER_MATERIAL=4
BOLINGO_MAX_ITEMS_PER_LESSON=8

# --------------------------------------------------------- lesson generation
# auto | offline | openai | claude
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
RAG_ENABLED=false

# --------------------------------------------------------------------- speech
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------ sessions
# Bearer-token lifetime; POST /api/auth/logout revokes tokens immediately.
BOLINGO_TOKEN_TTL_SECONDS=2592000

# -------------------------------------------------------------- background
# In-process weekly league rollover. Disable it and run `python -m app.jobs`
# from cron/systemd if you prefer an external scheduler.
BOLINGO_SCHEDULER_ENABLED=true
BOLINGO_LEAGUE_ROLLOVER_CHECK_SECONDS=300

# --------------------------------------------------------------- gamification
BOLINGO_PASS_THRESHOLD=0.8
BOLINGO_HEARTS_MAX=5
BOLINGO_HEART_REFILL_SECONDS=1800
BOLINGO_XP_PER_CORRECT=10
BOLINGO_XP_PERFECT_BONUS=20

# -------------------------------------------------------------------- network
# Comma-separated browser origins allowed by CORS. Restrict this in production.
BOLINGO_CORS_ORIGINS=*

# ------------------------------------------------------------------- supabase
# Optional: enables Supabase Storage and the Supabase upload path in the web app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PATH=/lessons
SUPABASE_DB=

# ------------------------------------------------------------------ web (Vite)
# Put these in web/.env.local, not in this file.
# VITE_API_BASE=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_STORAGE_BUCKET=
# VITE_SUPABASE_STORAGE_PATH=

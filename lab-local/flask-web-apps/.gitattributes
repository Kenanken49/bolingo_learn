# The image bakes these files and bash/Python run them inside a Linux
# container. A Windows checkout with core.autocrlf=true would otherwise hand
# the shell engine CRLF line endings, and a CRLF script fails to run — so the
# lab is stored and checked out as LF everywhere.
lab eol=lf
Dockerfile eol=lf
docker-compose.yml eol=lf
*.sh eol=lf
*.py eol=lf
*.sql eol=lf
*.json eol=lf
*.md eol=lf
*.html eol=lf
*.css eol=lf
*.toml eol=lf
*.cfg eol=lf
.flaskenv eol=lf
